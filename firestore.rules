rules_version = '2';

// O banco fica fechado para acesso direto (site, aplicativos, qualquer pessoa).
// Só a API acessa, usando a chave da conta de serviço, que não passa por estas regras.
// Veja docs/banco-de-dados.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
