# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado ao GitHub. Explicação de cada variável em app/config.py.

# Onde guardar os dados: "memoria" (padrão) ou "firestore"
ARMAZENAMENTO=firestore

# Login obrigatório: "ligada" (padrão) ou "desligada" (só para testar no computador; usa o usuário "demo")
AUTENTICACAO=desligada

# Caminho da chave da conta de serviço do Firebase (baixada no console do Firebase)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Endereços do site que podem chamar a API, separados por vírgula ("*" libera todos)
ORIGENS_PERMITIDAS=*
